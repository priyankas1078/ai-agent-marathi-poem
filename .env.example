# Copy this file to .env for local testing. Never commit the real .env file.
# This is the only secret the pipeline needs now — poems.json is written
# locally to disk (no email/chat delivery), and in GitHub Actions the git
# push step authenticates using the automatically provided GITHUB_TOKEN
# (no secret to configure for that part).

GEMINI_API_KEY=your_google_ai_studio_api_key_here
